{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "markets.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "markets"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "markets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/market"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "not": {
        "const": "default"
      }
    },
    "market": {
      "type": "object",
      "required": [
        "id",
        "name",
        "bounds"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "bounds": {
          "description": "[west, south, east, north] in degrees; west < east and south < north is checked by tools/registry.py",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ]
        },
        "stations": {
          "description": "TV call signs in this market (informational, shown by the configurator)",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9-]{3,10}$"
          }
        }
      }
    }
  }
}
